{
  "name": "soat-execution-service",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint 'src/**/*.ts'",
    "quality:sonarjs": "eslint --config eslint.sonar.config.mjs 'src/**/*.ts' --max-warnings=0",
    "test:unit": "jest --runInBand",
    "test:contracts": "node scripts/contracts/check.cjs",
    "test:delivery": "node scripts/check-delivery.cjs",
    "test:cov": "jest --runInBand --coverage",
    "test:coverage-infrastructure": "jest --config jest.infrastructure.config.cjs --runInBand",
    "test:observability-local": "node scripts/integration/observability-local.cjs",
    "test:cosmos-queue": "node scripts/integration/fila-cosmos.cjs",
    "ops:backfill-queue": "node scripts/operations/backfill-fila.cjs",
    "ops:recover-outbox": "node scripts/operations/recover-outbox.cjs",
    "start:prod": "node dist/main.js"
  },
  "dependencies": {
    "@azure/cosmos": "^4.10.1",
    "@azure/identity": "^4.14.1",
    "@azure/service-bus": "^7.10.0",
    "@nestjs/common": "^11.0.17",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.1.11",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/testing": "^11.2.8",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.18.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "yaml": "2.9.1"
  }
}
