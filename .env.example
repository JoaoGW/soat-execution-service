COSMOS_ENDPOINT="https://example.documents.azure.com:443/"
COSMOS_DATABASE="execution_hml"
COSMOS_CONTAINER="operations"
OTEL_SERVICE_NAME="soat-execution-service"
OTEL_SERVICE_VERSION="local"
OBSERVABILITY_ENABLED="false"
# NEW_RELIC_LICENSE_KEY deve vir de um secret; não salvar valor real aqui.
SERVICE_BUS_NAMESPACE="example.servicebus.windows.net"
SERVICE_BUS_COMMAND_QUEUE="execution.commands"
SERVICE_BUS_EVENT_TOPIC="soat.domain.events"

# Desativado por padrão; requer identidade federada e recursos existentes.
ENABLE_EXECUTION_OUTBOX="false"
ENABLE_EXECUTION_COMMANDS="false"
